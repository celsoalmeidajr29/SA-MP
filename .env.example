# ─── Banco de dados ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://osc:oscpassword@postgres:5432/oscdb
POSTGRES_USER=osc
POSTGRES_PASSWORD=oscpassword
POSTGRES_DB=oscdb

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://:oscredis@redis:6379
REDIS_PASSWORD=oscredis

# ─── MinIO (armazenamento de arquivos) ───────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=oscminio
MINIO_SECRET_KEY=oscminio123
MINIO_BUCKET=osc-files
MINIO_ROOT_USER=oscminio
MINIO_ROOT_PASSWORD=oscminio123

# ─── IA ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── Auth (gere com: openssl rand -base64 32) ────────────────────────────────
NEXTAUTH_SECRET=sua-chave-secreta-aqui
NEXTAUTH_URL=https://osc.app

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Google OAuth (para Drive e Gmail) ───────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://osc.app/api/integrations/google/callback

# ─── Bot ─────────────────────────────────────────────────────────────────────
SESSION_PATH=./sessions
TZ=America/Sao_Paulo
NODE_ENV=production
